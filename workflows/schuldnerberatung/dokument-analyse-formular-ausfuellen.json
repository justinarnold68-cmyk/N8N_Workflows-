      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Dokument herunterladen",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [460, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "ERSETZEN_CREDENTIAL_ID",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Dateiname und MIME-Typ ermitteln\nconst fileName = $('Google Drive Trigger').item.json.name || 'dokument';\nconst mimeType = $('Google Drive Trigger').item.json.mimeType || '';\nconst fileId = $('Google Drive Trigger').item.json.id;\nconst fileSize = $('Google Drive Trigger').item.json.size || 0;\n\n// Binarydaten prüfen\nconst binaryData = $input.item.binary;\nlet base64Content = '';\n\nif (binaryData && binaryData.data) {\n  base64Content = binaryData.data.data;\n}\n\nreturn [{\n  json: {\n    fileName,\n    mimeType,\n    fileId,\n    fileSize,\n    base64Content,\n    isImage: mimeType.startsWith('image/'),\n    isPDF: mimeType === 'application/pdf',\n    timestamp: new Date().toISOString()\n  },\n  binary: binaryData\n}];"
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Datei vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-6\",\n  \"max_tokens\": 4096,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"Du bist ein spezialisierter KI-Assistent für deutsche Schuldnerberatung. Analysiere das folgende Schreiben (Schuldenbrief, Mahnung, Inkassoschreiben oder Gerichtsbescheid) und extrahiere alle relevanten Informationen für das Standard-Schuldnerberatungsformular.\\n\\n## SCHULDNER (Empfänger des Schreibens)\\n- schuldner_vorname: Vorname des Schuldners\\n- schuldner_nachname: Nachname des Schuldners\\n- schuldner_strasse: Straße und Hausnummer des Schuldners\\n- schuldner_plz: Postleitzahl des Schuldners\\n- schuldner_ort: Wohnort des Schuldners\\n- schuldner_geburtsdatum: Geburtsdatum des Schuldners (TT.MM.JJJJ), falls erwähnt\\n\\n## ABSENDER / GLÄUBIGER\\n- absender_name: Vollständiger Name des Gläubigers, Inkassobüros oder der Kanzlei\\n- absender_strasse: Straße und Hausnummer des Absenders\\n- absender_plz: PLZ des Absenders\\n- absender_ort: Ort des Absenders\\n- absender_typ: Art des Absenders — eines von: GLAEUBIGER | INKASSO | ANWALT | GERICHT\\n- urspruenglicher_glaeubiger: Falls Inkasso/Anwalt: Name des ursprünglichen Gläubigers\\n\\n## FORDERUNGSDETAILS\\n- aktenzeichen: Aktenzeichen, Kundennummer oder Referenznummer\\n- vertragsnummer: Vertragsnummer oder Kontonummer (falls vorhanden)\\n- art_der_schuld: Art der Schuld — eines von: KREDIT | DARLEHEN | MIETE | STROM_GAS | TELEKOMMUNIKATION | VERSICHERUNG | KAUFVERTRAG | KRANKENVERSICHERUNG | SONSTIGES\\n- ursprungsvertrag: Bezeichnung des ursprünglichen Produkts/Vertrags (z.B. \\\"Ratenkredit\\\", \\\"Mobilfunkvertrag\\\")\\n- hauptforderung: Hauptforderungsbetrag in Euro (nur Zahl, kein €-Zeichen)\\n- zinsen: Zinsbetrag in Euro (nur Zahl)\\n- mahngebuehren: Mahngebühren in Euro (nur Zahl)\\n- inkassokosten: Inkasso- oder Anwaltskosten in Euro (nur Zahl)\\n- gesamtforderung: Gesamtforderungsbetrag in Euro (nur Zahl)\\n- faellig_seit: Datum seit wann die Forderung fällig ist (TT.MM.JJJJ)\\n\\n## MAHNUNG / SCHREIBEN\\n- mahndatum: Datum des Schreibens (TT.MM.JJJJ)\\n- mahnstufe: Stufe — eines von: ERSTE_MAHNUNG | ZWEITE_MAHNUNG | DRITTE_MAHNUNG | INKASSO | KLAGE | VOLLSTRECKUNG | MAHNBESCHEID | PFAENDUNG | SONSTIGES\\n- zahlungsfrist: Datum bis wann gezahlt werden muss (TT.MM.JJJJ)\\n- zahlungsfrist_tage: Anzahl der Tage bis zur Frist (Zahl)\\n\\n## ZAHLUNGSDATEN DES GLÄUBIGERS\\n- iban_glaeubiger: IBAN des Gläubigers für die Zahlung\\n- bic_glaeubiger: BIC des Gläubigers\\n- bank_glaeubiger: Name der Bank des Gläubigers\\n- verwendungszweck: Angegebener Verwendungszweck für die Zahlung\\n\\n## RECHTLICHE SITUATION\\n- rechtliche_schritte_angedroht: true oder false\\n- art_rechtliche_schritte: Welche Schritte angedroht werden (z.B. \\\"Klage\\\", \\\"Pfändung\\\", \\\"Schufa-Meldung\\\", \\\"Vollstreckung\\\")\\n- bereits_tituliert: true oder false (ob bereits ein Vollstreckungstitel/Gerichtsbescheid vorliegt)\\n- aktenzeichen_gericht: Gerichtliches Aktenzeichen (falls vorhanden)\\n\\n## BESONDERHEITEN\\n- ratenzahlung_angeboten: true oder false\\n- ratenzahlung_betrag: Angebotener Ratenbetrag in Euro (nur Zahl)\\n- vergleich_angeboten: true oder false\\n- vergleich_betrag: Angebotener Vergleichsbetrag in Euro\\n- besonderheiten: Weitere wichtige Informationen oder Besonderheiten des Schreibens\\n\\nAntworte NUR mit einem validen JSON-Objekt ohne Kommentare. Setze nicht erkennbare Felder auf null. Zahlen immer als Zahl (nicht als String). Boolesche Werte als true/false.\\n\\nDateiname des Dokuments: {{ $json.fileName }}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Claude Dokument analysieren",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ERSETZEN_ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Claude-Antwort parsen\nconst responseBody = $input.item.json;\nlet extractedData = {};\n\ntry {\n  // Anthropic-Antwortstruktur: body.content[0].text\n  const rawText = responseBody.content[0].text;\n  \n  // JSON aus dem Text extrahieren\n  const jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    extractedData = JSON.parse(jsonMatch[0]);\n  }\n} catch (error) {\n  extractedData = { fehler: 'JSON-Parsing fehlgeschlagen: ' + error.message };\n}\n\n// Dateinamen vom Trigger holen\nconst fileName = $('Google Drive Trigger').item.json.name || 'unbekannt';\nconst fileId = $('Google Drive Trigger').item.json.id;\n\nreturn [{\n  json: {\n    ...extractedData,\n    _meta: {\n      quelldatei: fileName,\n      datei_id: fileId,\n      verarbeitet_am: new Date().toISOString(),\n      status: extractedData.fehler ? 'Fehler' : 'Erfolg'\n    }\n  }\n}];"
      },

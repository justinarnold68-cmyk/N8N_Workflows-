      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Dokument herunterladen",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [460, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "ERSETZEN_CREDENTIAL_ID",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Dateiname und MIME-Typ ermitteln\nconst fileName = $('Google Drive Trigger').item.json.name || 'dokument';\nconst mimeType = $('Google Drive Trigger').item.json.mimeType || '';\nconst fileId = $('Google Drive Trigger').item.json.id;\nconst fileSize = $('Google Drive Trigger').item.json.size || 0;\n\n// Binarydaten prüfen\nconst binaryData = $input.item.binary;\nlet base64Content = '';\n\nif (binaryData && binaryData.data) {\n  base64Content = binaryData.data.data;\n}\n\nreturn [{\n  json: {\n    fileName,\n    mimeType,\n    fileId,\n    fileSize,\n    base64Content,\n    isImage: mimeType.startsWith('image/'),\n    isPDF: mimeType === 'application/pdf',\n    timestamp: new Date().toISOString()\n  },\n  binary: binaryData\n}];"
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Datei vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-6\",\n  \"max_tokens\": 4096,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": \"Du bist ein spezialisierter KI-Assistent für deutsche Schuldnerberatung. Analysiere das folgende Dokument und extrahiere alle relevanten Informationen für ein Schuldnerberatungsformular.\\n\\nExtrahiere folgende Felder (falls vorhanden):\\n- vorname: Vorname der Person\\n- nachname: Nachname der Person\\n- geburtsdatum: Geburtsdatum (Format: TT.MM.JJJJ)\\n- strasse: Straße und Hausnummer\\n- plz: Postleitzahl\\n- ort: Wohnort\\n- telefon: Telefonnummer\\n- email: E-Mail-Adresse\\n- familienstand: Familienstand (ledig/verheiratet/geschieden/verwitwet)\\n- anzahl_kinder: Anzahl der unterhaltsberechtigten Kinder\\n- beschaeftigung: Beschäftigungsstatus (angestellt/selbständig/arbeitslos/rentner/sonstiges)\\n- arbeitgeber: Name des Arbeitgebers (falls zutreffend)\\n- netto_einkommen: Monatliches Nettoeinkommen in Euro\\n- sonstige_einnahmen: Sonstige monatliche Einnahmen in Euro\\n- miete: Monatliche Miete/Wohnkosten in Euro\\n- lebenshaltung: Geschätzte monatliche Lebenshaltungskosten in Euro\\n- glaeubiger: Array von Gläubigern mit Name, Betrag und Art der Schuld\\n- gesamtschulden: Gesamtschuldenbetrag in Euro\\n- bank: Name der Hausbank\\n- iban: IBAN (falls vorhanden, anonymisiert)\\n- besonderheiten: Besondere Umstände oder Anmerkungen\\n\\nAntworte NUR mit einem validen JSON-Objekt. Setze nicht gefundene Felder auf null. Beispiel für glaeubiger: [{\\\"name\\\": \\\"Bank XY\\\", \\\"betrag\\\": 5000, \\\"art\\\": \\\"Kredit\\\"}]\\n\\nDokumentinhalt/Dateiname: {{ $json.fileName }}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Claude Dokument analysieren",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ERSETZEN_ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Claude-Antwort parsen\nconst responseBody = $input.item.json;\nlet extractedData = {};\n\ntry {\n  // Anthropic-Antwortstruktur: body.content[0].text\n  const rawText = responseBody.content[0].text;\n  \n  // JSON aus dem Text extrahieren\n  const jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    extractedData = JSON.parse(jsonMatch[0]);\n  }\n} catch (error) {\n  extractedData = { fehler: 'JSON-Parsing fehlgeschlagen: ' + error.message };\n}\n\n// Dateinamen vom Trigger holen\nconst fileName = $('Google Drive Trigger').item.json.name || 'unbekannt';\nconst fileId = $('Google Drive Trigger').item.json.id;\n\nreturn [{\n  json: {\n    ...extractedData,\n    _meta: {\n      quelldatei: fileName,\n      datei_id: fileId,\n      verarbeitet_am: new Date().toISOString(),\n      status: extractedData.fehler ? 'Fehler' : 'Erfolg'\n    }\n  }\n}];"
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Daten extrahieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "ERSETZEN_GOOGLE_SHEET_ID",

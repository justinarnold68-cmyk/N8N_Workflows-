        "sheetName": {
          "__rl": true,
          "value": "Schuldnerberatung",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Datum": "={{ $json._meta.verarbeitet_am }}",
            "Quelldatei": "={{ $json._meta.quelldatei }}",
            "Status": "={{ $json._meta.status }}",
            "Vorname": "={{ $json.vorname }}",
            "Nachname": "={{ $json.nachname }}",
            "Geburtsdatum": "={{ $json.geburtsdatum }}",
            "Straße": "={{ $json.strasse }}",
            "PLZ": "={{ $json.plz }}",
            "Ort": "={{ $json.ort }}",
            "Telefon": "={{ $json.telefon }}",
            "Email": "={{ $json.email }}",
            "Familienstand": "={{ $json.familienstand }}",
            "Anzahl Kinder": "={{ $json.anzahl_kinder }}",
            "Beschäftigung": "={{ $json.beschaeftigung }}",
            "Arbeitgeber": "={{ $json.arbeitgeber }}",
            "Netto Einkommen (€)": "={{ $json.netto_einkommen }}",
            "Sonstige Einnahmen (€)": "={{ $json.sonstige_einnahmen }}",
            "Miete (€)": "={{ $json.miete }}",
            "Lebenshaltung (€)": "={{ $json.lebenshaltung }}",
            "Gesamtschulden (€)": "={{ $json.gesamtschulden }}",
            "Bank": "={{ $json.bank }}",
            "Besonderheiten": "={{ $json.besonderheiten }}",
            "Gläubiger (JSON)": "={{ JSON.stringify($json.glaeubiger) }}"
          }
        },
        "options": {}
      },

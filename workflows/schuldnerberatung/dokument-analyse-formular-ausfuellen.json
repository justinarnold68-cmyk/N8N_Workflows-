            "Art rechtl. Schritte": "={{ $json.art_rechtliche_schritte }}",
            "Bereits tituliert": "={{ $json.bereits_tituliert }}",
            "Ratenzahlung angeboten": "={{ $json.ratenzahlung_angeboten }}",
